# Example environment variables for Visione docker-compose
VISIONE_ROOT=/absolute/path/to/your/visione/data
VISIONE_PORT=8080
VISIONE_USERNAME=your_tomcat_user
VISIONE_PASSWORD=your_tomcat_pass
# Optionally set these if needed by your deployment
VISIONE_VIDEOS_URL=http://localhost:8080/videos/
VISIONE_RESIZED_VIDEOS_URL=http://localhost:8080/videos_resized/
VISIONE_FRAMES_URL=http://localhost:8080/frames/
VISIONE_RESIZED_FRAMES_URL=http://localhost:8080/frames_resized/
VISIONE_PALETTE_URL=http://localhost:8080/palette/
VISIONE_TRANSLATE_URL=http://localhost:8080/translate/
VISIONE_SERVER_NAME=localhost
